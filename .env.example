# Groq AI (server-side only; never commit the real key)
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_STT_MODEL="whisper-large-v3"

# APP_URL: public Render URL
APP_URL="https://YOUR-RENDER-SERVICE.onrender.com"

# Supabase durable cloud database
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# REQUIRED for secure server-side writes. Do not use the sb_publishable key here.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional persistent disk path. If omitted, ./database is used.
LINGOFI_DATA_DIR=""
